<%- include('partials/header') %>

<header class="page-intro">
  <p class="eyebrow">Aquarium habitats</p>
  <h1>Zones</h1>

  <p class="page-intro__text">
    Explore the different themed areas of Aquarium World.
  </p>
</header>

<section class="content-section" aria-labelledby="zones-heading">
  <div class="section-heading">
    <h2 id="zones-heading">Explore our aquarium</h2>

    <p>
      Each zone introduces a different aquatic environment, its wildlife
      and the conservation stories behind it.
    </p>
  </div>

  <div class="card-grid">
    <% zones.forEach(zone => { %>
      <article class="zone-card">
        <div class="zone-card__content">
          <h3><%= zone.name %></h3>

          <p><%= zone.short_description %></p>

          <a class="card-link" href="/zones/<%= zone.slug %>">
            Explore <%= zone.name %>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>