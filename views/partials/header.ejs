<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Aquarium World is a new indoor aquarium with themed marine zones, exhibits, events and conservation stories. Open every day, 9am to 6pm.">
  <meta name="theme-color" content="#061a2b">
  <title><%= typeof pageTitle !== "undefined" && pageTitle ? `${pageTitle} | Aquarium World` : "Aquarium World" %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header">
    <div class="hours-bar">
      <div class="hours-bar__inner">
        <svg class="hours-bar__icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 7v5l3 2"></path>
        </svg>
        <p>Open every day, 9am–6pm</p>
      </div>
    </div>

    <div class="site-header__inner">
      <a class="site-logo" href="/" aria-label="Aquarium World home">
        Aquarium World
      </a>

      <nav class="site-nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/zones">Zones</a>
        <a href="/events">Events</a>
        <a href="/activity">Activity</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main-content" class="site-main">
