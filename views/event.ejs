<%- include('partials/header') %>

<article class="event-detail">
  <p class="eyebrow"><%= event.categoryName %></p>
  <h1><%= event.name %></h1>

  <p class="event-detail__date">
    <time datetime="<%= event.eventDate %>">
      <%= event.dateLabel %>
    </time>
  </p>

  <p class="event-detail__status">
    <% if (isPast) { %>
      This event has already taken place.
    <% } else { %>
      Upcoming event
    <% } %>
  </p>

  <% if (event.imagePath) { %>
    <img
      class="event-detail__image"
      src="<%= event.imagePath %>"
      alt="<%= event.name %>"
    >
  <% } %>

  <p class="event-detail__description"><%= event.description %></p>

  <a class="card-link" href="/events">Back to all events</a>
</article>

<%- include('partials/footer') %>